+static ssize_t airphy_polarity_write(struct file *file, const char __user *ptr,
+				     size_t len, loff_t *off)
+{
+	struct phy_device *phydev = file->private_data;
+	char buf[32], param1[32], param2[32];
+	size_t count = len;
+	int ret = 0, tx_rx = 0;
+
+	memset(buf, 0, 32);
+	memset(param1, 0, 32);
+	memset(param2, 0, 32);
+
+	if (count > sizeof(buf) - 1)
+		return -EINVAL;
+	if (copy_from_user(buf, ptr, len))
+		return -EFAULT;
+	if (sscanf(buf, "%12s %12s", param1, param2) != 2)
+		return -EFAULT;
+
+	if (!strcmp("tx_normal", param1)) {
+		if (!strcmp("rx_normal", param2)) {
+			tx_rx = AIR_POL_TX_NOR_RX_NOR;
+		} else if (!strcmp("rx_reverse", param2)) {
+			tx_rx = AIR_POL_TX_NOR_RX_REV;
+		} else {
+			pr_notice("\nRx param is not correct.\n");
+			return -EINVAL;
+		}
+	} else if (!strcmp("tx_reverse", param1)) {
+		if (!strcmp("rx_normal", param2)) {
+			tx_rx = AIR_POL_TX_REV_RX_NOR;
+		} else if (!strcmp("rx_reverse", param2)) {
+			tx_rx = AIR_POL_TX_REV_RX_REV;
+		} else {
+			pr_notice("\nRx param is not correct.\n");
+			return -EINVAL;
+		}
+	} else {
+		air_polarity_help();
+		return count;
+	}
+	pr_notice("\nSet Polarity %s\n", tx_rx_string[tx_rx]);
+	ret = air_set_polarity(phydev, tx_rx);
+	if (ret < 0)
+		return ret;
+	return count;
+}

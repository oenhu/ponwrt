+static int airphy_counter_show(struct seq_file *seq, void *v)
+{
+	struct phy_device *phydev = seq->private;
+
+	int ret = 0;
+	u32 pkt_cnt = 0;
+	struct en8811h_priv *priv = phydev->priv;
+
+	ret = air_read_status(phydev);
+	if (ret < 0)
+		return ret;
+	seq_puts(seq, "==========AIR PHY COUNTER==========\n");
+	if (priv->link) {
+		ret = airphy_ss_counter_show(phydev, seq);
+		if (ret < 0)
+			return ret;
+	}
+	ret = airphy_fcm_counter_show(phydev, seq);
+	if (ret < 0)
+		return ret;
+	if (priv->link) {
+		ret = airphy_mac_counter_show(seq, phydev);
+		if (ret < 0)
+			return ret;
+	}
+	if (priv->link && priv->speed == SPEED_2500) {
+		seq_puts(seq, "|\t<<LS Counter>>\n");
+		ret = air_buckpbus_reg_write(phydev, 0x30718, 0x10);
+		if (ret < 0)
+			return ret;
+		ret = air_buckpbus_reg_write(phydev, 0x30718, 0x0);
+		if (ret < 0)
+			return ret;
+		seq_puts(seq, "|\tBefore EF\n");
+		seq_puts(seq, "| Tx to Line side_S        :");
+		ret = air_buckpbus_reg_read(phydev, 0x3071c, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Tx to Line side_T        :");
+		ret = air_buckpbus_reg_read(phydev, 0x30720, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Tx_ENC                   :");
+		ret = air_buckpbus_reg_read(phydev, 0x30724, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Rx from Line side_S      :");
+		ret = air_buckpbus_reg_read(phydev, 0x3072c, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Rx from Line side_T      :");
+		ret = air_buckpbus_reg_read(phydev, 0x30730, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Rx_DEC                   :");
+		ret = air_buckpbus_reg_read(phydev, 0x30728, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "|\tAfter EF\n");
+		seq_puts(seq, "| Tx to Line side_S        :");
+		ret = air_buckpbus_reg_read(phydev, 0x30734, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Tx to Line side_T        :");
+		ret = air_buckpbus_reg_read(phydev, 0x30738, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Rx from Line side_S      :");
+		ret = air_buckpbus_reg_read(phydev, 0x30764, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n", pkt_cnt);
+		seq_puts(seq, "| Rx from Line side_T      :");
+		ret = air_buckpbus_reg_read(phydev, 0x30768, &pkt_cnt);
+		if (ret < 0)
+			return ret;
+		seq_printf(seq, "%010u |\n\n", pkt_cnt);
+		ret = air_buckpbus_reg_write(phydev, 0x30718, 0x13);
+		ret |= air_buckpbus_reg_write(phydev, 0x30718, 0x3);
+		ret |= air_buckpbus_reg_write(phydev, 0x30718, 0x10);
+		ret |= air_buckpbus_reg_write(phydev, 0x30718, 0x0);
+		if (ret < 0)
+			return ret;
+	}
+	if (priv->link && priv->speed != SPEED_2500) {
+		int saved_page;
+
+		seq_puts(seq, "|\t<<LS Counter>>\n");
+		saved_page = phy_select_page(phydev, 1);
+		if (saved_page < 0)
+			return phy_restore_page(phydev, saved_page, 0);
+		ret = __phy_read(phydev, 0x12);
+		if (ret < 0)
+			return phy_restore_page(phydev, saved_page, ret);
+		seq_printf(seq, "| Rx from Line side        :%010u |\n",
+			   ret & 0x7fff);
+		ret = __phy_read(phydev, 0x17);
+		if (ret < 0)
+			return phy_restore_page(phydev, saved_page, ret);
+		seq_printf(seq, "| Rx Error from Line side  :%010u |\n",
+			   ret & 0xff);
+		ret = phy_restore_page(phydev, saved_page, 0);
+		if (ret < 0)
+			return ret;
+
+		saved_page = phy_select_page(phydev, 0x52b5);
+		if (saved_page < 0)
+			return phy_restore_page(phydev, saved_page, 0);
+		ret = __phy_write(phydev, 0x10, 0xbf92);
+		if (ret < 0)
+			return phy_restore_page(phydev, saved_page, ret);
+		ret = __phy_read(phydev, 0x11);
+		if (ret < 0)
+			return phy_restore_page(phydev, saved_page, ret);
+		seq_printf(seq, "| Tx to Line side          :%010u |\n",
+			   (ret & 0x7ffe) >> 1);
+		ret = __phy_read(phydev, 0x12);
+		if (ret < 0)
+			return phy_restore_page(phydev, saved_page, ret);
+		seq_printf(seq, "| Tx Error to Line side    :%010u |\n\n",
+			   ret & 0x7f);
+		ret = phy_restore_page(phydev, saved_page, 0);
+	}
+	return ret;
+}

+static int airoha_led_control(struct phy_device *phydev, int force_mode)
+{
+	struct en8811h_priv *priv = phydev->priv;
+	int ret, id, on_evt;
+
+	if (force_mode != AIR_LED_NORMAL &&
+	    force_mode != AIR_LED_FORCE_OFF &&
+	    force_mode != AIR_LED_FORCE_ON)
+		return -EINVAL;
+
+	if (force_mode && !priv->led_hw_control) {
+		/* Save all three LEDs before the first temporary force override. */
+		for (id = 0; id < EN8811H_LED_COUNT; id++) {
+			ret = phy_read_mmd(phydev, MDIO_MMD_VEND2, LED_ON_CTRL(id));
+			if (ret < 0)
+				return ret;
+			priv->on_crtl[id] = ret;
+			ret = phy_read_mmd(phydev, MDIO_MMD_VEND2, LED_BLK_CTRL(id));
+			if (ret < 0)
+				return ret;
+			priv->blk_crtl[id] = ret;
+		}
+		priv->led_hw_control = true;
+	}
+
+	if (!force_mode && !priv->led_hw_control)
+		return 0;
+
+	for (id = 0; id < EN8811H_LED_COUNT; id++) {
+		if (force_mode) {
+			on_evt = phy_read_mmd(phydev, MDIO_MMD_VEND2, LED_ON_CTRL(id));
+			if (on_evt < 0)
+				return on_evt;
+			on_evt &= ~(LED_ON_EVT_LINK_2500M |
+				    LED_ON_EVT_LINK_100M | LED_ON_EVT_LINK_1000M);
+			if (force_mode == AIR_LED_FORCE_ON)
+				on_evt |= LED_ON_EVT_FORCE;
+			else
+				on_evt &= ~LED_ON_EVT_FORCE;
+
+			ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, LED_ON_CTRL(id), on_evt);
+			if (ret < 0)
+				return ret;
+			ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, LED_BLK_CTRL(id), 0);
+		} else {
+			ret = phy_write_mmd(phydev, MDIO_MMD_VEND2,
+					    LED_ON_CTRL(id), priv->on_crtl[id]);
+			if (ret < 0)
+				return ret;
+			ret = phy_write_mmd(phydev, MDIO_MMD_VEND2,
+					    LED_BLK_CTRL(id), priv->blk_crtl[id]);
+		}
+		if (ret < 0)
+			return ret;
+	}
+	if (!force_mode)
+		priv->led_hw_control = false;
+	return 0;
+}

+static void airphy_debugfs_mii_cl22_help(void)
+{
+	pr_notice("\nUsage:\n"
+		  "[debugfs] = /sys/kernel/debug/mdio-bus\':[phy_addr]\n"
+		  "Read:\n"
+		  "echo r [phy_register] > /[debugfs]/mii_mgr_op\n"
+		  "Write:\n"
+		  "echo w [phy_register] [value] > /[debugfs]/mii_mgr_op\n");
+}

+	case AIR_PORT_MODE_FORCE_100:
+		pr_notice("\nForce 100M\n");
+		val = phy_read(phydev, MII_ADVERTISE);
+		if (val < 0)
+			return val;
+		val = (val | BIT(8)) & ~BIT(12);
+		ret = phy_write(phydev, MII_ADVERTISE, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_CTRL1000);
+		if (val < 0)
+			return val;
+		val = val & ~BIT(9);
+		ret = phy_write(phydev, MII_CTRL1000, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read_mmd(phydev, 0x7, 0x20);
+		if (val < 0)
+			return val;
+		val = val & ~BIT(7);
+		ret = phy_write_mmd(phydev, 0x7, 0x20, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val = val | BIT(9);
+		ret = phy_write(phydev, MII_BMCR, val);
+		if (unlikely(ret < 0))
+			break;
+		priv->need_an = 1;
+		break;
+	case AIR_PORT_MODE_FORCE_1000:
+		pr_notice("\nForce 1000M\n");
+		val = phy_read(phydev, MII_ADVERTISE);
+		if (val < 0)
+			return val;
+		val = (val & ~BIT(8)) | BIT(12);
+		ret = phy_write(phydev, MII_ADVERTISE, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_CTRL1000);
+		if (val < 0)
+			return val;
+		val = val | BIT(9);
+		ret = phy_write(phydev, MII_CTRL1000, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read_mmd(phydev, 0x7, 0x20);
+		if (val < 0)
+			return val;
+		val = val & ~BIT(7);
+		ret = phy_write_mmd(phydev, 0x7, 0x20, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val = val | BIT(9);
+		ret = phy_write(phydev, MII_BMCR, val);
+		if (unlikely(ret < 0))
+			break;
+		priv->need_an = 1;
+		break;
+	case AIR_PORT_MODE_FORCE_2500:
+		pr_notice("\nForce 2500M\n");
+		val = phy_read(phydev, MII_ADVERTISE);
+		if (val < 0)
+			return val;
+		val = (val & ~BIT(8)) | BIT(12);
+		ret = phy_write(phydev, MII_ADVERTISE, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_CTRL1000);
+		if (val < 0)
+			return val;
+		val = val & ~BIT(9);
+		ret = phy_write(phydev, MII_CTRL1000, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read_mmd(phydev, 0x7, 0x20);
+		if (val < 0)
+			return val;
+		val = val | BIT(7);
+		ret = phy_write_mmd(phydev, 0x7, 0x20, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val = val | BIT(9);
+		ret = phy_write(phydev, MII_BMCR, val);
+		if (unlikely(ret < 0))
+			break;
+		priv->need_an = 1;
+		break;
+	case AIR_PORT_MODE_AUTONEGO:
+		pr_notice("\nAutonego mode\n");
+		val = phy_read(phydev, MII_ADVERTISE);
+		if (val < 0)
+			return val;
+		val = val | BIT(8) | BIT(12);
+		ret = phy_write(phydev, MII_ADVERTISE, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_CTRL1000);
+		if (val < 0)
+			return val;
+		val = val | BIT(9);
+		ret = phy_write(phydev, MII_CTRL1000, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read_mmd(phydev, 0x7, 0x20);
+		if (val < 0)
+			return val;
+		val = val | BIT(7);
+		ret = phy_write_mmd(phydev, 0x7, 0x20, val);
+		if (unlikely(ret < 0))
+			break;
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val |= BMCR_ANENABLE;
+		ret = phy_write(phydev, MII_BMCR, val);
+		if (unlikely(ret < 0))
+			break;
+		if (priv->need_an) {
+			val = phy_read(phydev, MII_BMCR);
+			if (val < 0)
+				return val;
+			val |= BMCR_ANRESTART;
+			ret = phy_write(phydev, MII_BMCR, val);
+			if (unlikely(ret < 0))
+				break;
+			priv->need_an = 0;
+			pr_notice("\nRe-an\n");
+		}
+		break;
+	case AIR_PORT_MODE_POWER_DOWN:
+		pr_notice("\nPower Down\n");
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val = val | BIT(11);
+		ret = phy_write(phydev, MII_BMCR, val);
+		break;
+	case AIR_PORT_MODE_POWER_UP:
+		pr_notice("\nPower Up\n");
+		val = phy_read(phydev, MII_BMCR);
+		if (val < 0)
+			return val;
+		val = val & ~BIT(11);
+		ret = phy_write(phydev, MII_BMCR, val);
+		break;
+	default:
+		pr_notice("\nWrong Port mode\n");
+		break;
+	}
+	return ret;
+}
